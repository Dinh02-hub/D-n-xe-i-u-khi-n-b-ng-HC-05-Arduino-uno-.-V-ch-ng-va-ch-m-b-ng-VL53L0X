        <item name="android:navigationBarColor">?attr/driveBackground</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
    </style>
    <style name="Theme.ArduinoDrive.Welcome" parent="Theme.ArduinoDrive.Welcome.Base">
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
