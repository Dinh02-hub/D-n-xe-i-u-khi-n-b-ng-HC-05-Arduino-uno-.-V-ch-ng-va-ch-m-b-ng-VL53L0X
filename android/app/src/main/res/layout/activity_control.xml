<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:splitMotionEvents="true"
        android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
            <ImageButton app:tint="?attr/driveInk" android:id="@+id/backButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_arrow_back" android:contentDescription="@string/back" />
            <TextView android:id="@+id/controlStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/simulation_on" android:textSize="15sp" android:textColor="?attr/driveInk" android:fontFamily="sans-serif-medium" />
            <ImageButton app:tint="?attr/driveInk" android:id="@+id/logButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_log" android:contentDescription="@string/log_label" />
            <ImageButton app:tint="?attr/driveInk" android:id="@+id/settingsButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_settings" android:contentDescription="@string/settings" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="4dp" android:background="?attr/driveLine" />
        <com.google.android.material.card.MaterialCardView android:id="@+id/sensorCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardCornerRadius="12dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="?attr/driveLine" app:cardBackgroundColor="?attr/driveSurface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/sensorWarning" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp" android:paddingVertical="8dp" android:visibility="gone"
                    android:background="@color/sensor_warning_surface" android:textColor="@color/sensor_warning_ink"
                    android:text="@string/sensor_fault" android:textSize="13sp" android:accessibilityLiveRegion="polite" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:paddingVertical="10dp">
                    <TextView android:id="@+id/frontDistance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="20dp" android:text="@string/front_distance_unknown" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:textColor="?attr/driveInk" />
                    <TextView android:id="@+id/frontStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/sensor_no_data" android:textSize="13sp" android:textColor="?attr/driveMuted" android:accessibilityLiveRegion="polite" />
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/avoidanceSwitch" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="12dp" android:text="@string/avoidance_label" android:textSize="13sp" android:checked="true" android:switchPadding="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" android:baselineAligned="false" android:splitMotionEvents="true">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/forwardButton" style="@style/Drive.OutlineButton" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="10dp" android:text="@string/forward" android:textSize="24sp" app:backgroundTint="@color/control_button_tint" />
                <com.google.android.material.button.MaterialButton android:id="@+id/reverseButton" style="@style/Drive.OutlineButton" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="@string/reverse" android:textSize="24sp" app:backgroundTint="@color/control_button_tint" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.25" android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:orientation="vertical" android:gravity="center">
                <TextView style="@style/Drive.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/speed_label" />
                <FrameLayout android:id="@+id/speedGauge" android:layout_width="match_parent" android:layout_height="100dp" android:layout_marginTop="4dp">
                    <com.arduinodrive.ui.SpeedArcView android:id="@+id/speedArc" android:layout_width="match_parent" android:layout_height="match_parent" />
                    <TextView android:id="@+id/speedValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="12dp" android:text="@string/speed_initial" android:textSize="40sp" android:fontFeatureSettings="tnum" android:letterSpacing="-0.04" android:fontFamily="sans-serif-medium" android:textColor="?attr/driveInk" />
                </FrameLayout>
                <TextView android:id="@+id/motionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="@string/idle" android:textSize="14sp" android:textColor="?attr/driveMuted" android:maxLines="2" />
                <com.google.android.material.slider.Slider android:id="@+id/speedSlider" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/speed_label" android:valueFrom="0" android:valueTo="100" android:stepSize="1" android:value="60" app:labelBehavior="gone" app:trackHeight="3dp" app:thumbRadius="9dp" app:tickVisible="false" />
                <TextView android:id="@+id/settingsStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/settings_syncing" android:textSize="12sp" android:textColor="?attr/driveMuted" android:accessibilityLiveRegion="polite" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15" android:orientation="vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/leftButton" style="@style/Drive.OutlineButton" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginBottom="10dp" android:text="@string/left" android:textSize="24sp" app:backgroundTint="@color/control_button_tint" />
                <com.google.android.material.button.MaterialButton android:id="@+id/rightButton" style="@style/Drive.OutlineButton" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="@string/right" android:textSize="24sp" app:backgroundTint="@color/control_button_tint" />
                <com.google.android.material.button.MaterialButton android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="12dp" android:text="@string/stop" android:textSize="20sp" android:letterSpacing="0.04" android:textColor="?attr/driveOnDanger" app:backgroundTint="?attr/driveDanger" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <View android:id="@+id/debugScrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/driveScrim" android:visibility="gone" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/debugPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_panel" android:focusable="true" android:importantForAccessibility="noHideDescendants"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior" app:behavior_hideable="true" app:behavior_peekHeight="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/log_label" android:textSize="18sp" android:textColor="?attr/driveInk" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/sessionTimer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:text="@string/timer_initial" android:textColor="?attr/driveMuted" android:textSize="13sp" android:fontFamily="monospace" />
            <ImageButton app:tint="?attr/driveInk" android:id="@+id/closeLogButton" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_close" android:contentDescription="@string/close" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
            <TextView android:id="@+id/motorValues" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/motor_initial" android:textSize="13sp" android:fontFamily="monospace" android:textColor="?attr/driveMuted" />
            <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/simulationSwitch" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/simulation_short" android:textSize="14sp" />
        </LinearLayout>
        <TextView android:id="@+id/commandLog" android:layout_width="match_parent" android:layout_height="72dp" android:gravity="center_vertical" android:text="@string/log_empty" android:fontFamily="monospace" android:textSize="12sp" android:textColor="?attr/driveInk" android:maxLines="3" />
        <TextView android:id="@+id/logCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/log_initial" android:textSize="12sp" android:textColor="?attr/driveMuted" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
